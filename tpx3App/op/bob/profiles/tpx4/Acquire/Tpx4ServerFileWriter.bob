  <widget type="action_button" version="3.0.0">
    <name>PushDestination</name>
    <actions><action type="write_pv"><description>Apply TPX4 destinations</description><pv_name>$(P)$(R)WriteData</pv_name><value>1</value></action></actions>
    <text>Apply destination</text><x>770</x><y>88</y><width>174</width><height>29</height>
    <background_color><color red="115" green="205" blue="238"/></background_color>
    <tooltip>Push enabled Raw, Preview 0 and Image 0 channels to Serval, then refresh readbacks. TPX4 histogram output remains blocked.</tooltip>
  </widget>
