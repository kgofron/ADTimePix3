<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Tpx4ServerFileWriter</name>
  <width>850</width>
  <height>430</height>
  <background_color><color red="187" green="187" blue="187"/></background_color>
  <grid_step_x>5</grid_step_x>
  <grid_step_y>5</grid_step_y>

  <widget type="label" version="2.0.0">
    <name>Title</name>
    <text>Timepix4 Preview Destination — $(P)$(R)</text>
    <x>5</x><y>5</y><width>840</width><height>25</height>
    <font><font family="Sans" style="BOLD" size="14.0"/></font>
    <foreground_color><color red="10" green="0" blue="184"/></foreground_color>
    <background_color><color red="220" green="235" blue="255"/></background_color>
    <transparent>false</transparent><horizontal_alignment>1</horizontal_alignment>
  </widget>

  <widget type="label" version="2.0.0">
    <name>Boundary</name>
    <text>Experimental TPX4 scope: Preview.ImageChannels[0] only. Raw, histogram, Image[], Preview[1], thresholds and calibration are not enabled.</text>
    <x>15</x><y>38</y><width>820</width><height>35</height>
    <wrap_words>true</wrap_words>
    <foreground_color><color red="150" green="60" blue="0"/></foreground_color>
  </widget>

  <widget type="label" version="2.0.0">
    <name>FamilyLabel</name><text>Family</text>
    <x>15</x><y>82</y><width>85</width><height>22</height><horizontal_alignment>2</horizontal_alignment>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Family</name><pv_name>$(P)$(R)DetectorFamily_RBV</pv_name>
    <x>105</x><y>82</y><width>100</width><height>22</height><format>6</format>
  </widget>
  <widget type="label" version="2.0.0">
    <name>WritePreviewLabel</name><text>Preview enabled</text>
    <x>225</x><y>82</y><width>105</width><height>22</height><horizontal_alignment>2</horizontal_alignment>
  </widget>
  <widget type="bool_button" version="2.0.0">
    <name>WritePreview</name><pv_name>$(P)$(R)WritePrvImg</pv_name><bit>-1</bit>
    <x>335</x><y>80</y><width>75</width><height>24</height>
    <off_color><color red="120" green="120" blue="120"/></off_color>
    <on_color><color red="0" green="220" blue="0"/></on_color>
    <tooltip>Enable Preview.ImageChannels[0] in the next destination push</tooltip>
  </widget>
  <widget type="led" version="2.0.0">
    <name>WritePreviewRBV</name><pv_name>$(P)$(R)WritePrvImg_RBV</pv_name>
    <x>418</x><y>82</y><width>20</width><height>20</height>
    <off_color><color red="150" green="150" blue="150"/></off_color>
    <on_color><color red="0" green="220" blue="0"/></on_color>
    <tooltip>Serval destination readback</tooltip>
  </widget>
  <widget type="label" version="2.0.0">
    <name>PvaLabel</name><text>PVA callbacks</text>
    <x>465</x><y>82</y><width>95</width><height>22</height><horizontal_alignment>2</horizontal_alignment>
  </widget>
  <widget type="bool_button" version="2.0.0">
    <name>PvaEnable</name><pv_name>$(P)Pva1:EnableCallbacks</pv_name><bit>-1</bit>
    <x>565</x><y>80</y><width>75</width><height>24</height>
    <off_color><color red="120" green="120" blue="120"/></off_color>
    <on_color><color red="0" green="220" blue="0"/></on_color>
    <tooltip>Publish decoded preview NDArrays as pva://$(P)Pva1:Image</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>PushDestination</name>
    <actions><action type="write_pv"><description>Push TPX4 preview destination</description><pv_name>$(P)$(R)WriteData</pv_name><value>1</value></action></actions>
    <text>Apply Destination</text>
    <x>665</x><y>78</y><width>165</width><height>28</height>
    <background_color><color red="115" green="223" blue="255"/></background_color>
    <tooltip>PUT the enabled destination channels to Serval and refresh readbacks</tooltip>
  </widget>

  <widget type="group" version="3.0.0">
    <name>PreviewChannel</name><x>10</x><y>115</y><width>830</width><height>220</height>
    <widget type="label" version="2.0.0">
      <name>GroupTitle</name><text>Preview.ImageChannels[0]</text>
      <x>5</x><y>2</y><width>210</width><height>20</height>
      <font><font family="Sans" style="BOLD" size="11.0"/></font>
    </widget>
    <widget type="label" version="2.0.0">
      <name>PathLabel</name><text>Base (set)</text><x>10</x><y>32</y><width>90</width><height>22</height><horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>Path</name><pv_name>$(P)$(R)PrvImgFilePath</pv_name>
      <x>105</x><y>30</y><width>700</width><height>22</height>
      <background_color><color red="115" green="223" blue="255"/></background_color><format>6</format>
    </widget>
    <widget type="label" version="2.0.0">
      <name>PathRBVLabel</name><text>Base (RBV)</text><x>10</x><y>60</y><width>90</width><height>22</height><horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>PathRBV</name><pv_name>$(P)$(R)PrvImgFilePath_RBV</pv_name>
      <x>105</x><y>58</y><width>700</width><height>22</height><format>6</format>
    </widget>

    <widget type="label" version="2.0.0"><name>FormatLabel</name><text>Format</text><x>10</x><y>92</y><width>70</width><height>22</height><horizontal_alignment>2</horizontal_alignment></widget>
    <widget type="combo" version="2.0.0"><name>Format</name><pv_name>$(P)$(R)PrvImgFileFmt</pv_name><x>85</x><y>90</y><width>120</width><height>22</height><background_color><color red="115" green="223" blue="255"/></background_color></widget>
    <widget type="textupdate" version="2.0.0"><name>FormatRBV</name><pv_name>$(P)$(R)PrvImgFileFmt_RBV</pv_name><x>210</x><y>90</y><width>90</width><height>22</height><format>6</format></widget>
    <widget type="label" version="2.0.0"><name>ModeLabel</name><text>Mode</text><x>315</x><y>92</y><width>55</width><height>22</height><horizontal_alignment>2</horizontal_alignment></widget>
    <widget type="combo" version="2.0.0"><name>Mode</name><pv_name>$(P)$(R)PrvImgFileMode</pv_name><x>375</x><y>90</y><width>120</width><height>22</height><background_color><color red="115" green="223" blue="255"/></background_color></widget>
    <widget type="textupdate" version="2.0.0"><name>ModeRBV</name><pv_name>$(P)$(R)PrvImgFileMode_RBV</pv_name><x>500</x><y>90</y><width>90</width><height>22</height><format>6</format></widget>
    <widget type="label" version="2.0.0"><name>QueueLabel</name><text>Queue</text><x>605</x><y>92</y><width>55</width><height>22</height><horizontal_alignment>2</horizontal_alignment></widget>
    <widget type="textentry" version="3.0.0"><name>Queue</name><pv_name>$(P)$(R)PrvImgQueueSize</pv_name><x>665</x><y>90</y><width>65</width><height>22</height><background_color><color red="115" green="223" blue="255"/></background_color></widget>
    <widget type="textupdate" version="2.0.0"><name>QueueRBV</name><pv_name>$(P)$(R)PrvImgQueueSize_RBV</pv_name><x>735</x><y>90</y><width>70</width><height>22</height></widget>

    <widget type="label" version="2.0.0"><name>PeriodLabel</name><text>Period (s)</text><x>10</x><y>126</y><width>70</width><height>22</height><horizontal_alignment>2</horizontal_alignment></widget>
    <widget type="textentry" version="3.0.0"><name>Period</name><pv_name>$(P)$(R)PrvPeriod</pv_name><x>85</x><y>124</y><width>90</width><height>22</height><background_color><color red="115" green="223" blue="255"/></background_color><precision>6</precision></widget>
    <widget type="textupdate" version="2.0.0"><name>PeriodRBV</name><pv_name>$(P)$(R)PrvPeriod_RBV</pv_name><x>180</x><y>124</y><width>90</width><height>22</height><precision>6</precision></widget>
    <widget type="label" version="2.0.0"><name>SamplingLabel</name><text>Sampling</text><x>285</x><y>126</y><width>65</width><height>22</height><horizontal_alignment>2</horizontal_alignment></widget>
    <widget type="combo" version="2.0.0"><name>Sampling</name><pv_name>$(P)$(R)PrvSmplgMode</pv_name><x>355</x><y>124</y><width>130</width><height>22</height><background_color><color red="115" green="223" blue="255"/></background_color></widget>
    <widget type="textupdate" version="2.0.0"><name>SamplingRBV</name><pv_name>$(P)$(R)PrvSmplgMode_RBV</pv_name><x>490</x><y>124</y><width>110</width><height>22</height><format>6</format></widget>

    <widget type="label" version="2.0.0"><name>IntSizeLabel</name><text>Integration</text><x>10</x><y>160</y><width>70</width><height>22</height><horizontal_alignment>2</horizontal_alignment></widget>
    <widget type="textentry" version="3.0.0"><name>IntSize</name><pv_name>$(P)$(R)PrvImgIntgSize</pv_name><x>85</x><y>158</y><width>65</width><height>22</height><background_color><color red="115" green="223" blue="255"/></background_color></widget>
    <widget type="textupdate" version="2.0.0"><name>IntSizeRBV</name><pv_name>$(P)$(R)PrvImgIntgSize_RBV</pv_name><x>155</x><y>158</y><width>65</width><height>22</height></widget>
    <widget type="label" version="2.0.0"><name>IntModeLabel</name><text>Mode</text><x>235</x><y>160</y><width>50</width><height>22</height><horizontal_alignment>2</horizontal_alignment></widget>
    <widget type="combo" version="2.0.0"><name>IntMode</name><pv_name>$(P)$(R)PrvImgIntgMode</pv_name><x>290</x><y>158</y><width>110</width><height>22</height><background_color><color red="115" green="223" blue="255"/></background_color></widget>
    <widget type="textupdate" version="2.0.0"><name>IntModeRBV</name><pv_name>$(P)$(R)PrvImgIntgMode_RBV</pv_name><x>405</x><y>158</y><width>100</width><height>22</height><format>6</format></widget>
    <widget type="label" version="2.0.0"><name>PathExistsLabel</name><text>Path valid</text><x>530</x><y>160</y><width>70</width><height>22</height><horizontal_alignment>2</horizontal_alignment></widget>
    <widget type="led" version="2.0.0"><name>PathExists</name><pv_name>$(P)$(R)PrvImgFilePathExists_RBV</pv_name><x>605</x><y>158</y><width>20</width><height>20</height><off_color><color red="220" green="0" blue="0"/></off_color><on_color><color red="0" green="220" blue="0"/></on_color></widget>
  </widget>

  <widget type="label" version="2.0.0"><name>HttpLabel</name><text>HTTP</text><x>20</x><y>350</y><width>55</width><height>22</height><horizontal_alignment>2</horizontal_alignment></widget>
  <widget type="textupdate" version="2.0.0"><name>HttpCode</name><pv_name>$(P)$(R)HttpCode_RBV</pv_name><x>80</x><y>348</y><width>65</width><height>22</height></widget>
  <widget type="label" version="2.0.0"><name>PolicyLabel</name><text>Policy</text><x>165</x><y>350</y><width>55</width><height>22</height><horizontal_alignment>2</horizontal_alignment></widget>
  <widget type="textupdate" version="2.0.0"><name>Policy</name><pv_name>$(P)$(R)DestinationPolicy_RBV</pv_name><x>225</x><y>348</y><width>160</width><height>22</height><format>6</format></widget>
  <widget type="label" version="2.0.0"><name>EndpointLabel</name><text>PVA</text><x>405</x><y>350</y><width>40</width><height>22</height><horizontal_alignment>2</horizontal_alignment></widget>
  <widget type="label" version="2.0.0"><name>Endpoint</name><text>pva://$(P)Pva1:Image</text><x>450</x><y>348</y><width>380</width><height>22</height></widget>
  <widget type="label" version="2.0.0"><name>MessageLabel</name><text>Message</text><x>20</x><y>384</y><width>55</width><height>22</height><horizontal_alignment>2</horizontal_alignment></widget>
  <widget type="textupdate" version="2.0.0">
    <name>Message</name><pv_name>$(P)$(R)WriteFileMessage</pv_name>
    <x>80</x><y>380</y><width>750</width><height>28</height><format>6</format>
    <background_color><color red="245" green="245" blue="245"/></background_color><border_width>1</border_width>
  </widget>
</display>
