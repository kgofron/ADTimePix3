    <name>WritePreviewRBV</name><pv_name>$(P)$(R)WritePrvImg_RBV</pv_name>
    <x>253</x><y>92</y><width>20</width><height>20</height>
    <off_color><color red="153" green="163" blue="175"/></off_color>
    <on_color><color red="47" green="177" blue="118"/></on_color>
    <tooltip>Preview channel enabled in Serval destination readback</tooltip>
  </widget>
