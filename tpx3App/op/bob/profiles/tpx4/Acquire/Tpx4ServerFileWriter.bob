    <font><font family="Sans" style="BOLD" size="11.0"/></font>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>EnablePreview</name>
    <actions><action type="write_pv"><description>Enable TPX4 preview channel</description><pv_name>$(P)$(R)WritePrvImg</pv_name><value>1</value></action></actions>
    <text>Enable</text>
    <x>160</x><y>89</y><width>84</width><height>26</height>
    <background_color><color red="224" green="243" blue="252"/></background_color>
    <tooltip>Include Preview.ImageChannels[0] in the next destination push</tooltip>
  </widget>
