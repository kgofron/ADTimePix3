<?xml version='1.0' encoding='UTF-8'?>
<display version="2.0.0">
  <name>Tpx4RawDestination</name>
  <width>980</width>
  <height>930</height>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <x>20</x>
    <y>15</y>
    <width>930</width>
    <height>30</height>
    <text>Timepix4 / Raw destinations — Serval 4.3.0</text>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Hint</name>
    <x>20</x>
    <y>55</y>
    <width>930</width>
    <height>40</height>
    <text>Configure while idle, then Apply destination. File paths belong to the Serval computer. Raw[1] requires Raw[0].</text>
    <wrap_words>true</wrap_words>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Apply</name>
    <x>750</x>
    <y>105</y>
    <width>210</width>
    <height>30</height>
    <text>Apply destination</text>
    <actions>
      <action type="write_pv">
        <description>Apply enabled TPX4 destinations</description>
        <pv_name>$(P)$(R)WriteData</pv_name>
        <value>1</value>
      </action>
    </actions>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Version</name>
    <x>20</x>
    <y>108</y>
    <width>240</width>
    <height>25</height>
    <pv_name>$(P)$(R)SDKVersion_RBV</pv_name>
    <format>6</format>
  </widget>
  <widget type="label" version="2.0.0">
    <name>RawTitle</name>
    <x>20</x>
    <y>155</y>
    <width>450</width>
    <height>25</height>
    <text>Raw[0] — file or external TCP consumer</text>
  </widget>
  <widget type="bool_button" version="2.0.0">
    <name>RawEnable</name>
    <x>650</x>
    <y>155</y>
    <width>120</width>
    <height>25</height>
    <pv_name>$(P)$(R)WriteRaw</pv_name>
    <bit>-1</bit>
    <tooltip>Include this raw channel when applying destinations</tooltip>
  </widget>
  <widget type="led" version="2.0.0">
    <name>RawApplied</name>
    <x>800</x>
    <y>155</y>
    <width>22</width>
    <height>22</height>
    <pv_name>$(P)$(R)WriteRaw_RBV</pv_name>
    <tooltip>Channel present in Serval destination readback</tooltip>
  </widget>
