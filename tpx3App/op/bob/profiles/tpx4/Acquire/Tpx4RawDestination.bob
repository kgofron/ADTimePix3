<?xml version='1.0' encoding='UTF-8'?>
<display version="2.0.0">
  <name>Tpx4RawDestination</name>
  <width>980</width>
  <height>930</height>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <x>20</x>
    <y>15</y>
    <width>930</width>
    <height>30</height>
    <text>Timepix4 / Raw destinations — Serval 4.3.0</text>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Hint</name>
    <x>20</x>
    <y>55</y>
    <width>930</width>
    <height>40</height>
    <text>Configure while idle, then Apply destination. File paths belong to the Serval computer. Raw[1] requires Raw[0].</text>
    <wrap_words>true</wrap_words>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Apply</name>
    <x>750</x>
    <y>105</y>
    <width>210</width>
    <height>30</height>
    <text>Apply destination</text>
    <actions>
      <action type="write_pv">
        <description>Apply enabled TPX4 destinations</description>
        <pv_name>$(P)$(R)WriteData</pv_name>
        <value>1</value>
      </action>
    </actions>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Version</name>
    <x>20</x>
    <y>108</y>
    <width>240</width>
    <height>25</height>
    <pv_name>$(P)$(R)SDKVersion_RBV</pv_name>
    <format>6</format>
  </widget>
  <widget type="label" version="2.0.0">
    <name>RawTitle</name>
    <x>20</x>
    <y>155</y>
    <width>450</width>
    <height>25</height>
    <text>Raw[0] — file or external TCP consumer</text>
  </widget>
  <widget type="bool_button" version="2.0.0">
    <name>RawEnable</name>
    <x>650</x>
    <y>155</y>
    <width>120</width>
    <height>25</height>
    <pv_name>$(P)$(R)WriteRaw</pv_name>
    <bit>-1</bit>
    <tooltip>Include this raw channel when applying destinations</tooltip>
  </widget>
  <widget type="led" version="2.0.0">
    <name>RawApplied</name>
    <x>800</x>
    <y>155</y>
    <width>22</width>
    <height>22</height>
    <pv_name>$(P)$(R)WriteRaw_RBV</pv_name>
    <tooltip>Channel present in Serval destination readback</tooltip>
  </widget>
  <widget type="label" version="2.0.0">
    <name>RawAppliedLabel</name>
    <x>830</x>
    <y>155</y>
    <width>100</width>
    <height>23</height>
    <text>Applied</text>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>RawFilePathReadback</name>
    <x>240</x>
    <y>180</y>
    <width>500</width>
    <height>16</height>
    <pv_name>$(P)$(R)RawFilePath_RBV</pv_name>
    <format>6</format>
    <font><font family="Sans" style="REGULAR" size="12" /></font>
    <foreground_color><color red="10" green="0" blue="184" /></foreground_color>
    <tooltip>Normalized requested URI stored by the IOC; applied JSON below confirms the Serval destination</tooltip>
  </widget>
  <widget type="label" version="2.0.0">
    <name>RawFilePathExistsLabel</name>
    <x>750</x>
    <y>180</y>
    <width>100</width>
    <height>16</height>
    <text>Exists (IOC):</text>
    <font><font family="Sans" style="REGULAR" size="12" /></font>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>RawFilePathExists</name>
    <x>860</x>
    <y>180</y>
    <width>90</width>
    <height>16</height>
    <pv_name>$(P)$(R)RawFilePathExists_RBV</pv_name>
    <font><font family="Sans" style="REGULAR" size="12" /></font>
    <tooltip>Checks directory existence on the IOC computer. A Yes for TCP/HTTP is not a connection test.</tooltip>
  </widget>
  <widget type="label" version="2.0.0">
    <name>RawFilePathLabel</name>
    <x>20</x>
    <y>197</y>
    <width>210</width>
    <height>25</height>
