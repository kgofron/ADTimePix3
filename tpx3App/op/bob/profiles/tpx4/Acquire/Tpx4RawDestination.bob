  </widget>
  <widget type="textentry" version="3.0.0">
    <name>RawFilePath</name>
    <x>240</x>
    <y>197</y>
    <width>660</width>
    <height>25</height>
    <pv_name>$(P)$(R)RawFilePath</pv_name>
    <format>6</format>
    <tooltip>Output directory on the Serval computer, or an explicitly entered TCP destination URI</tooltip>
  </widget>
  <widget type="fileselector" version="2.0.0">
    <name>RawDirectoryBrowse</name>
    <pv_name>$(P)$(R)RawFilePath</pv_name>
    <component>1</component>
    <x>910</x>
    <y>197</y>
    <width>40</width>
    <height>25</height>
    <tooltip>Choose a directory visible on this computer and Serval; the IOC adds file:</tooltip>
  </widget>
