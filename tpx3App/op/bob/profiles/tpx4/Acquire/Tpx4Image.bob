  <widget type="bool_button" version="2.0.0">
    <name>LatestFrameAutoscale</name>
    <x>690</x>
    <y>174</y>
    <width>90</width>
    <height>28</height>
    <visible>false</visible>
    <rules>
      <rule name="Selected view" prop_id="visible" out_exp="false">
        <exp bool_exp="pvInt0==0">
          <value>true</value>
        </exp>
        <pv_name>loc://$(P)$(R)Tpx4ImageViewMode&lt;VEnum&gt;(0,"Latest frame","Last N sum","Accumulated sum")</pv_name>
      </rule>
    </rules>
    <pv_name>loc://$(P)$(R)Tpx4LatestFrameAuto(1)</pv_name>
    <bit>-1</bit>
    <off_label>Manual</off_label>
    <on_label>Auto</on_label>
    <tooltip>Auto follows the full image. Switch to Manual to freeze the current limits.</tooltip>
  </widget>
  <widget type="textentry" version="3.0.0">
    <name>LatestFrameMinimum</name>
    <x>690</x>
    <y>718</y>
    <width>90</width>
    <height>28</height>
    <visible>false</visible>
    <rules>
      <rule name="Selected view" prop_id="visible" out_exp="false">
        <exp bool_exp="pvInt0==0">
          <value>true</value>
        </exp>
        <pv_name>loc://$(P)$(R)Tpx4ImageViewMode&lt;VEnum&gt;(0,"Latest frame","Last N sum","Accumulated sum")</pv_name>
      </rule>
      <rule name="Editable in Manual" prop_id="enabled" out_exp="false">
        <exp bool_exp="pvInt0==0">
          <value>true</value>
        </exp>
        <pv_name>loc://$(P)$(R)Tpx4LatestFrameAuto(1)</pv_name>
      </rule>
      <rule name="Large intensity: scientific notation" prop_id="format" out_exp="false">
        <exp bool_exp="pv0&gt;=1000000000 || pv0&lt;=-100000000">
          <value>2</value>
        </exp>
        <pv_name>loc://$(P)$(R)Tpx4LatestFrameMin(0)</pv_name>
      </rule>
      <rule name="Large intensity: four significant digits" prop_id="precision" out_exp="false">
        <exp bool_exp="pv0&gt;=1000000000 || pv0&lt;=-100000000">
          <value>3</value>
        </exp>
        <pv_name>loc://$(P)$(R)Tpx4LatestFrameMin(0)</pv_name>
      </rule>
    </rules>
    <precision>0</precision>
    <enabled>false</enabled>
    <pv_name>loc://$(P)$(R)Tpx4LatestFrameMin(0)</pv_name>
    <tooltip>Applied color limit; editable in Manual. Changes affect this view only.</tooltip>
    <format>1</format>
  </widget>
