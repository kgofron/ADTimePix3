      </rule>
      <rule name="X maximum" prop_id="x_axis.maximum" out_exp="true">
        <exp bool_exp="pvInt0&gt;0">
          <expression>pvInt0</expression>
        </exp>
        <pv_name>$(P)$(R)ImgSizeX_RBV</pv_name>
      </rule>
      <rule name="Y minimum" prop_id="y_axis.minimum" out_exp="true">
        <exp bool_exp="pvInt0&gt;0">
          <expression>pvInt0</expression>
        </exp>
        <pv_name>$(P)$(R)ImgSizeY_RBV</pv_name>
      </rule>
    </rules>
    <scripts>
      <script file="image_intensity.py">
        <pv_name trigger="true">loc://$(P)$(R)Tpx4LastNSumAuto(1)</pv_name>
        <pv_name trigger="true">loc://$(P)$(R)Tpx4LastNSumMin(0)</pv_name>
        <pv_name trigger="true">loc://$(P)$(R)Tpx4LastNSumMax(1000)</pv_name>
        <pv_name trigger="true">$(P)$(R)ImgImageSumNFrames</pv_name>
      </script>
      <script file="image_geometry.py">
        <pv_name trigger="true">$(P)$(R)ImgSizeX_RBV</pv_name>
        <pv_name trigger="true">$(P)$(R)ImgSizeY_RBV</pv_name>
        <pv_name trigger="true">$(P)$(R)ImgImageSumNFrames</pv_name>
        <pv_name trigger="true">loc://$(P)$(R)Tpx4ImageViewMode&lt;VEnum&gt;(0,"Latest frame","Last N sum","Accumulated sum")</pv_name>
      </script>
    </scripts>
  </widget>

