  <widget type="rectangle" version="2.0.0">
    <name>IntensityPanel</name>
    <x>678</x>
    <y>130</y>
    <width>110</width>
    <height>672</height>
    <line_width>1</line_width>
    <line_color>
      <color red="210" green="220" blue="231" />
    </line_color>
    <background_color>
      <color red="248" green="250" blue="252" />
    </background_color>
    <transparent>false</transparent>
  </widget>
  <widget type="label" version="2.0.0">
    <name>NoImage</name>
    <x>70</x>
    <y>365</y>
    <width>578</width>
    <height>100</height>
    <text>Waiting for processed Image data.
Enable Image 0 with a TCP jsonimage destination, enable processing, then acquire.</text>
    <wrap_words>true</wrap_words>
    <horizontal_alignment>1</horizontal_alignment>
    <foreground_color>
      <color red="92" green="105" blue="121" />
    </foreground_color>
  </widget>
  <widget type="image" version="2.0.0">
    <name>LatestFrame</name>
    <x>32</x>
    <y>130</y>
    <width>638</width>
    <height>672</height>
    <pv_name>$(P)$(R)ImgImageFrame</pv_name>
    <visible>false</visible>
    <data_width>1</data_width>
    <data_height>1</data_height>
    <color_map>
      <name>JET</name>
    </color_map>
    <autoscale>false</autoscale>
    <minimum>0</minimum>
    <maximum>1000</maximum>
    <x_axis>
      <visible>true</visible>
      <title>X (pixel)</title>
      <minimum>0.0</minimum>
      <maximum>1.0</maximum>
    </x_axis>
    <y_axis>
      <visible>true</visible>
      <title>Y (pixel)</title>
      <minimum>1.0</minimum>
      <maximum>0.0</maximum>
    </y_axis>
    <tooltip>Latest processed Image message; native pixel values.</tooltip>
    <rules>
      <rule name="Selected view with processed data" prop_id="visible" out_exp="false">
        <exp bool_exp="pvInt0==0 &amp;&amp; pv1&gt;0 &amp;&amp; pvInt2&gt;0">
          <value>true</value>
        </exp>
        <pv_name>loc://$(P)$(R)Tpx4ImageViewMode&lt;VEnum&gt;(0,"Latest frame","Last N sum","Accumulated sum")</pv_name>
        <pv_name>$(P)$(R)ImgAccumulatedFrames_RBV</pv_name>
        <pv_name>$(P)$(R)ImgAccumulationEnable_RBV</pv_name>
      </rule>
      <rule name="Image width" prop_id="data_width" out_exp="true">
        <exp bool_exp="pvInt0&gt;0">
          <expression>pvInt0</expression>
        </exp>
        <pv_name>$(P)$(R)ImgSizeX_RBV</pv_name>
      </rule>
      <rule name="Image height" prop_id="data_height" out_exp="true">
        <exp bool_exp="pvInt0&gt;0">
          <expression>pvInt0</expression>
        </exp>
        <pv_name>$(P)$(R)ImgSizeY_RBV</pv_name>
      </rule>
      <rule name="X maximum" prop_id="x_axis.maximum" out_exp="true">
        <exp bool_exp="pvInt0&gt;0">
          <expression>pvInt0</expression>
        </exp>
        <pv_name>$(P)$(R)ImgSizeX_RBV</pv_name>
      </rule>
      <rule name="Y minimum" prop_id="y_axis.minimum" out_exp="true">
        <exp bool_exp="pvInt0&gt;0">
          <expression>pvInt0</expression>
        </exp>
        <pv_name>$(P)$(R)ImgSizeY_RBV</pv_name>
      </rule>
    </rules>
    <scripts>
      <script file="image_intensity.py">
        <pv_name trigger="true">loc://$(P)$(R)Tpx4LatestFrameAuto(1)</pv_name>
        <pv_name trigger="true">loc://$(P)$(R)Tpx4LatestFrameMin(0)</pv_name>
        <pv_name trigger="true">loc://$(P)$(R)Tpx4LatestFrameMax(1000)</pv_name>
        <pv_name trigger="true">$(P)$(R)ImgImageFrame</pv_name>
      </script>
      <script file="image_geometry.py">
        <pv_name trigger="true">$(P)$(R)ImgSizeX_RBV</pv_name>
        <pv_name trigger="true">$(P)$(R)ImgSizeY_RBV</pv_name>
        <pv_name trigger="true">$(P)$(R)ImgImageFrame</pv_name>
        <pv_name trigger="true">loc://$(P)$(R)Tpx4ImageViewMode&lt;VEnum&gt;(0,"Latest frame","Last N sum","Accumulated sum")</pv_name>
      </script>
    </scripts>
  </widget>

  <widget type="image" version="2.0.0">
    <name>LastNSum</name>
    <x>32</x>
    <y>130</y>
    <width>638</width>
    <height>672</height>
    <pv_name>$(P)$(R)ImgImageSumNFrames</pv_name>
