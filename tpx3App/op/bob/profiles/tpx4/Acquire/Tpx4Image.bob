        <pv_name>loc://$(P)$(R)Tpx4ImageViewMode&lt;VEnum&gt;(0,"Latest frame","Last N sum","Accumulated sum")</pv_name>
        <pv_name>$(P)$(R)ImgFramesSummed_RBV</pv_name>
        <pv_name>$(P)$(R)ImgAccumulationEnable_RBV</pv_name>
      </rule>
      <rule name="Image width" prop_id="data_width" out_exp="true">
        <exp bool_exp="pvInt0&gt;0">
          <expression>pvInt0</expression>
        </exp>
        <pv_name>$(P)$(R)ImgSizeX_RBV</pv_name>
      </rule>
      <rule name="Image height" prop_id="data_height" out_exp="true">
